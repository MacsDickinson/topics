{
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "native-test",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "wdio:default",
            "wdio-webdriver:default",
            "core:window:allow-start-dragging"
          ]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Topics",
        "width": 1180,
        "height": 800,
        "minWidth": 560,
        "minHeight": 420,
        "incognito": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  }
}
